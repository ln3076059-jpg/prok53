APP_ENV=production
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=mysql+pymysql://roadwatch:replace-me@mysql:3306/driver_safety
MODEL_PATH=models/active/best.pt
MODEL_CONFIG_PATH=models/model_config_v2.yaml
UPLOAD_DIR=/var/lib/roadwatch/uploads
EVIDENCE_DIR=/var/lib/roadwatch/evidence
MAX_UPLOAD_MB=1024
ALLOW_CAMERA_STREAMS=false
CORS_ORIGINS=https://roadwatch.example.com
ACCESS_TOKEN_MINUTES=60
ANALYSIS_QUEUE_BACKEND=database
