{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V2 Event Sequence Annotation",
  "description": "Schema for sequence-level ground truth required for temporal calibration and event evaluation.",
  "type": "object",
  "required": [
    "sequence_id",
    "video_id",
    "vehicle_id",
    "cabin_id",
    "source_id",
    "fps",
    "frame_count",
    "start_time",
    "end_time",
    "occupants",
    "events",
    "context_intervals",
    "context",
    "review_provenance"
  ],
  "properties": {
    "sequence_id": { "type": "string" },
    "video_id": { "type": "string" },
    "source_id": { "type": "string" },
    "camera_id": { "type": "string" },
    "vehicle_id": { "type": "string", "minLength": 1, "pattern": "^video:[^:]+:(vehicle-track:[0-9]+|provided-vehicle)$" },
    "cabin_id": { "type": "string", "minLength": 1, "pattern": "^video:[^:]+:(vehicle-track:[0-9]+:cabin:[0-9]+|provided-cabin)$" },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "frame_count": { "type": "integer", "minimum": 1 },
    "start_time": { "type": "string", "format": "date-time" },
    "end_time": { "type": "string", "format": "date-time" },
    "occupants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["occupant_id", "role"],
        "properties": {
          "occupant_id": { "type": "string", "pattern": "^video:[^:]+:(vehicle-track:[0-9]+:cabin:[0-9]+|provided-cabin):occupant-track:[0-9]+$" },
          "role": { "type": "string", "enum": ["driver", "front_passenger", "rear_left", "rear_center", "rear_right", "unknown"] },
          "role_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reviewer_confirmed_role": { "type": "boolean" },
          "vehicle_context_confirmed": { "type": "boolean" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_type", "occupant_id", "start_frame", "end_frame", "label"],
        "properties": {
          "event_type": { "type": "string", "enum": ["PHONE", "SEATBELT"] },
          "occupant_id": { "type": "string", "pattern": "^video:[^:]+:(vehicle-track:[0-9]+:cabin:[0-9]+|provided-cabin):occupant-track:[0-9]+$" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "end_frame": { "type": "integer", "minimum": 0 },
          "start_time_sec": { "type": "number", "minimum": 0 },
          "end_time_sec": { "type": "number", "minimum": 0 },
          "label": {
            "type": "string",
            "enum": [
              "PHONE_USE",
              "PHONE_PRESENT_NOT_USED",
              "MOUNTED_OR_STATIC_PHONE",
              "NO_PHONE",
              "UNKNOWN",
              "FASTENED",
              "UNFASTENED",
              "UNCERTAIN_OR_OCCLUDED",
              "NOT_APPLICABLE"
            ]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "event_type": { "const": "PHONE" } } },
            "then": {
              "properties": {
                "label": {
                  "enum": [
                    "PHONE_USE",
                    "PHONE_PRESENT_NOT_USED",
                    "MOUNTED_OR_STATIC_PHONE",
                    "NO_PHONE",
                    "UNKNOWN"
                  ]
                }
              }
            }
          },
          {
            "if": { "properties": { "event_type": { "const": "SEATBELT" } } },
            "then": {
              "properties": {
                "label": {
                  "enum": [
                    "FASTENED",
                    "UNFASTENED",
                    "UNCERTAIN_OR_OCCLUDED",
                    "NOT_APPLICABLE"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "context_intervals": {
      "description": "Human-reviewed, half-open [start_frame, end_frame) context intervals. Every occupant must be covered continuously from frame 0 through frame_count.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "context_id",
          "occupant_id",
          "start_frame",
          "end_frame",
          "inside_vehicle",
          "outside_vehicle_person",
          "motorcycle_flag",
          "phone_state",
          "seatbelt_state",
          "visibility",
          "conditions"
        ],
        "properties": {
          "context_id": { "type": "string", "minLength": 1 },
          "occupant_id": { "type": "string", "minLength": 1, "pattern": "^video:[^:]+:(vehicle-track:[0-9]+:cabin:[0-9]+|provided-cabin):occupant-track:[0-9]+$" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "end_frame": { "type": "integer", "minimum": 1 },
          "inside_vehicle": { "type": "boolean" },
          "outside_vehicle_person": { "type": "boolean" },
          "motorcycle_flag": { "type": "boolean" },
          "phone_state": {
            "type": "string",
            "enum": [
              "PHONE_USE",
              "PHONE_PRESENT_NOT_USED",
              "MOUNTED_OR_STATIC_PHONE",
              "NO_PHONE",
              "UNKNOWN"
            ]
          },
          "seatbelt_state": {
            "type": "string",
            "enum": [
              "FASTENED",
              "UNFASTENED",
              "UNCERTAIN_OR_OCCLUDED",
              "NOT_APPLICABLE"
            ]
          },
          "visibility": { "type": "string", "minLength": 1 },
          "conditions": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "vehicle_type": { "type": "string" },
        "motorcycle_flag": { "type": "boolean" },
        "inside_vehicle": { "type": "boolean" },
        "outside_vehicle_person": { "type": "boolean" },
        "day_night": { "type": "string", "enum": ["day", "night", "unknown"] },
        "occlusion": { "type": "string", "enum": ["none", "partial", "heavy"] },
        "camera_viewpoint": { "type": "string" }
      }
    },
    "review_provenance": {
      "type": "object",
      "required": ["reviewer_type", "status", "annotation_version"],
      "properties": {
        "reviewer_type": { "type": "string", "enum": ["HUMAN", "AI"] },
        "reviewer_id": { "type": "string" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "evidence_hash": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["AI_REVIEWED_PROPOSAL", "HUMAN_APPROVED"]
        },
        "annotation_version": { "type": "string" },
        "adjudication_status": {
          "type": "string",
          "enum": ["PENDING", "FINAL"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "reviewer_type": { "const": "AI" } } },
          "then": { "properties": { "status": { "const": "AI_REVIEWED_PROPOSAL" } } }
        },
        {
          "if": { "properties": { "reviewer_type": { "const": "HUMAN" } } },
          "then": {
            "properties": { "status": { "const": "HUMAN_APPROVED" } },
            "required": ["reviewer_id", "reviewed_at", "evidence_hash"]
          }
        }
      ]
    }
  }
}
