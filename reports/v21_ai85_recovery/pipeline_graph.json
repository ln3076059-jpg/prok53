{
  "version": "21.0.0",
  "description": "ROADWATCH V21 Autonomous End-to-End Inference & Event Verification Graph",
  "nodes": [
    {
      "id": "frame_decoder",
      "name": "Hardware/OpenCV Frame Stream Decoder",
      "type": "input",
      "inputs": [
        "video_stream"
      ],
      "outputs": [
        "raw_frame_rgb",
        "timestamp_seconds",
        "frame_index"
      ],
      "parameters": {
        "native_fps": 29.76,
        "sampling_stride": 15
      }
    },
    {
      "id": "view_aware_roi",
      "name": "View-Aware Dynamic Occupant Seat ROI (R4)",
      "type": "geometry",
      "inputs": [
        "raw_frame_rgb"
      ],
      "outputs": [
        "driver_crop",
        "roi_normalized_coords"
      ],
      "parameters": {
        "calibrated_seat_bounds": [
          0.0,
          0.1,
          0.65,
          0.95
        ],
        "padding_px": 20
      }
    },
    {
      "id": "occupant_pose_tracker",
      "name": "Occupant Localization & Keypoint Estimation",
      "type": "pose",
      "model_checkpoint": "models/auxiliary/yolo11n-pose.pt",
      "inputs": [
        "driver_crop"
      ],
      "outputs": [
        "occupant_tracks",
        "hand_points",
        "face_points",
        "torso_points"
      ],
      "parameters": {
        "confidence_floor": 0.25
      }
    },
    {
      "id": "phone_detector_ensemble",
      "name": "Phone Detection Ensemble (Specialist + Auxiliary D5)",
      "type": "detector",
      "models": [
        "models/active/v2/phone_detector.pt",
        "models/auxiliary/yolo11n.pt"
      ],
      "inputs": [
        "driver_crop"
      ],
      "outputs": [
        "raw_phone_candidates"
      ],
      "parameters": {
        "confidence_floor": 0.15,
        "nms_iou_threshold": 0.5
      }
    },
    {
      "id": "driver_phone_association",
      "name": "Occupant Association & Anatomical Proximity Gating",
      "type": "association",
      "inputs": [
        "raw_phone_candidates",
        "occupant_tracks",
        "hand_points",
        "face_points"
      ],
      "outputs": [
        "associated_phone_candidates",
        "association_states",
        "rejection_codes"
      ],
      "parameters": {
        "hand_radius_px": 100.0,
        "face_radius_px": 85.0,
        "min_containment": 0.35,
        "ambiguity_margin": 0.15
      }
    },
    {
      "id": "action_recognition_adapter",
      "name": "Hybrid Pretrained Action Recognition Adapter (RuleGuided + V6 ResNet-GRU)",
      "type": "action_classifier",
      "model_checkpoint": "training/dmd/v6_action_hierarchy.py (LOSO Fold Checkpoints)",
      "inputs": [
        "driver_crop",
        "occupant_tracks",
        "associated_phone_candidates"
      ],
      "outputs": [
        "safe_driving_score",
        "phone_use_score",
        "other_activity_score",
        "uncertainty"
      ],
      "parameters": {
        "temporal_context_frames": 16,
        "safe_driving_suppression_threshold": 0.65
      }
    },
    {
      "id": "evidence_fusion_engine",
      "name": "Context & Action-Aware Evidence Fusion",
      "type": "fusion",
      "inputs": [
        "associated_phone_candidates",
        "action_recognition_adapter"
      ],
      "outputs": [
        "filtered_observation_stream"
      ],
      "parameters": {
        "require_handheld_context": true,
        "strict_driver_role_only": true
      }
    },
    {
      "id": "temporal_event_engine",
      "name": "Causal Online Temporal Event State Machine",
      "type": "temporal_engine",
      "inputs": [
        "filtered_observation_stream"
      ],
      "outputs": [
        "active_event_candidates",
        "finalized_violation_events"
      ],
      "parameters": {
        "window_seconds": 1.5,
        "min_positive_seconds": 0.5,
        "min_observations": 2,
        "cooldown_seconds": 3.0,
        "smoothing_alpha": 0.4
      }
    },
    {
      "id": "event_matcher_evaluator",
      "name": "Stage 2 Frozen Temporal Event Matcher (Post-Hoc Evaluation Only)",
      "type": "evaluation",
      "inputs": [
        "finalized_violation_events",
        "openlabel_ground_truth"
      ],
      "outputs": [
        "true_positives",
        "false_positives",
        "false_negatives",
        "metrics"
      ],
      "parameters": {
        "iou_threshold": 0.05,
        "onset_tolerance_s": 4.0,
        "offset_tolerance_s": 4.0
      }
    }
  ]
}
